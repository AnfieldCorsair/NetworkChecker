<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VpnChecker.App</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>VPN_Checker</AssemblyName>
    <Product>VPN_Checker</Product>
    <Company>VPN_Checker</Company>
    <Description>VPN_Checker — аудит ВПН-подписок, 6-сигнальный детектор метки Google RU и AI Studio, DNS-архитектор, ТСПУ и сетевой стек Windows</Description>
    <!-- Разрешаем подчёркивание в имени сборки VPN_Checker.exe без нарушения строгих правил в Core -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VpnChecker.Core\VpnChecker.Core.csproj" />
  </ItemGroup>
</Project>
