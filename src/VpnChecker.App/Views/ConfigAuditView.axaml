<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnChecker.App.ViewModels"
             x:Class="VpnChecker.App.Views.ConfigAuditView"
             x:DataType="vm:ConfigAuditViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="5*,7*" ColumnSpacing="16" RowSpacing="10" Margin="20,14">

    <!-- 1. Верхняя сводка и понятные кнопки проверки -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="14,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding VerdictHeadline}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
          <TextBlock Text="{Binding ProtocolSummary}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#93C5FD" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Ошибки" FontSize="11" Foreground="{StaticResource TextMuted}" />
            <TextBlock Text="{Binding CriticalCount}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Советы" FontSize="11" Foreground="{StaticResource TextMuted}" />
            <TextBlock Text="{Binding WarningCount}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="Отлично" FontSize="11" Foreground="{StaticResource TextMuted}" />
            <TextBlock Text="{Binding OkCount}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource CleanBrush}" HorizontalAlignment="Center" />
          </StackPanel>

          <Button Content="Проверить этот узел"
                  Classes="primary"
                  Command="{Binding ProbeCurrentEndpointCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Content="Проверить маскировку SNI"
                  Command="{Binding ProbeSniCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  IsVisible="{Binding ShowTechnicalDetails}" />
          <Button Content="Стабильность пинга (6×)"
                  Command="{Binding RunRttBenchmarkCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  IsVisible="{Binding ShowTechnicalDetails}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. Строка быстрой загрузки подписки по ссылке + точечная замена DNS и экспорт -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="card" Padding="12,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0"
                     Text="Подписка или ключ:"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   Text="{Binding SubscriptionUrl, Mode=TwoWay}"
                   Watermark="Вставьте ссылку https:// на подписку или ключ vless:// / hy2:// / trojan://" />
          <Button Grid.Column="2"
                  Content="Загрузить и проверить"
                  Classes="primary"
                  Command="{Binding FetchSubscriptionCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      Spacing="6"
                      IsVisible="{Binding ShowTechnicalDetails}">
            <Button Content="Автолечение (Блок-патч)" Command="{Binding ApplyBulkPatchCommand}" />
            <CheckBox Content="Скрывать личные пароли" IsChecked="{Binding MaskSecrets, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>

        <!-- Панель быстрой замены DNS и выгрузки исправленной подписки в Happ / v2rayN -->
        <WrapPanel Orientation="Horizontal">
          <Button Content="Вшить DNS: Классика (Cloudflare + Google)"
                  Command="{Binding QuickInjectClassicDnsCommand}"
                  Margin="0,0,8,4"
                  Padding="10,5" />
          <Button Content="Вшить приватный DNS (Njalla + LibreDNS)"
                  Command="{Binding QuickInjectNinjaDnsCommand}"
                  IsVisible="{Binding ShowTechnicalDetails}"
                  Margin="0,0,8,4"
                  Padding="10,5" />
          <Button Content="Скопировать выбранный узел (для Happ)"
                  Command="{Binding CopySelectedNodeOnlyCommand}"
                  Margin="0,0,8,4"
                  Padding="10,5" />
          <Button Content="Создать локальную ссылку подписки (127.0.0.1)"
                  Command="{Binding HostLocalSubscriptionCommand}"
                  IsVisible="{Binding ShowTechnicalDetails}"
                  Margin="0,0,8,4"
                  Padding="10,5" />
          <Button Content="Сохранить исправленную подписку в файл"
                  Command="{Binding SavePatchedSubscriptionFileCommand}"
                  IsVisible="{Binding ShowTechnicalDetails}"
                  Margin="0,0,8,4"
                  Padding="10,5" />
          <TextBlock Text="{Binding HostedSubscriptionUrl}"
                     IsVisible="{Binding HasHostedSubscriptionUrl}"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="11.5"
                     Foreground="#4ADE80"
                     VerticalAlignment="Center"
                     Margin="6,0,0,4" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- 3. Полная Карточка подписки (показывается, когда загружена подписка по ссылке или JSON-массив Happ) -->
    <Border Grid.Row="2"
            Grid.ColumnSpan="2"
            Classes="card"
            Background="#13203B"
            BorderBrush="#2563EB"
            BorderThickness="1"
            Padding="14,10"
            IsVisible="{Binding HasSubscriptionCard}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="КАРТОЧКА ПОДПИСКИ:" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SubscriptionTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SubscriptionNodesCountText}" FontSize="12.5" Foreground="#4ADE80" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SubscriptionTrafficText}" FontSize="12" Foreground="#E2E8F0" Margin="0,0,18,0" />
            <TextBlock Text="{Binding SubscriptionExpireText}" FontSize="12" Foreground="#93C5FD" Margin="0,0,18,0" />
            <TextBlock Text="{Binding SubscriptionSupportText}" FontSize="12" Foreground="{StaticResource TextMuted}" />
          </WrapPanel>
        </StackPanel>

        <Button Grid.Column="1"
                Content="Проверить ВСЕ узлы подписки одним кликом"
                Classes="primary"
                Command="{Binding ProbeAllSubscriptionNodesCommand}"
                IsEnabled="{Binding !IsBusy}"
                VerticalAlignment="Center"
                Padding="16,9" />
      </Grid>
    </Border>

    <!-- 4. Левая колонка: список локаций подписки + (в Расширенном режиме) пресеты и редактор конфига -->
    <Border Grid.Row="3" Grid.Column="0" Classes="card" Padding="14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Локации подписки" Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="Копировать всё"
                    Command="{Binding CopyConfigCommand}"
                    IsVisible="{Binding ShowTechnicalDetails}"
                    Padding="10,4" />
          </Grid>
          <WrapPanel Orientation="Horizontal" IsVisible="{Binding ShowTechnicalDetails}">
            <Button Content="Пример подписки Happ (JSON)" Command="{Binding LoadPresetCommand}" CommandParameter="happ" Margin="0,0,6,4" Padding="8,4" />
            <Button Content="VLESS XHTTP (эталон)" Command="{Binding LoadPresetCommand}" CommandParameter="xhttp" Margin="0,0,6,4" Padding="8,4" />
            <Button Content="VLESS с ошибками" Command="{Binding LoadPresetCommand}" CommandParameter="broken" Margin="0,0,6,4" Padding="8,4" />
            <Button Content="AmneziaWG" Command="{Binding LoadPresetCommand}" CommandParameter="awg" Margin="0,0,0,4" Padding="8,4" />
          </WrapPanel>
        </StackPanel>

        <!-- Список локаций подписки -->
        <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasMultipleNodes}" Spacing="6" Margin="0,0,0,10">
          <TextBlock Text="Выберите сервер для подробного разбора или копирования:" FontSize="12" Foreground="#93C5FD" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding SubscriptionNodes}"
                   SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                   MaxHeight="280"
                   Background="{StaticResource AppBackground}"
                   BorderBrush="{StaticResource BorderBrush2}"
                   BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SubscriptionNodeDisplayItem">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,3">
                  <StackPanel Spacing="2">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                      <Run Text="#" />
                      <Run Text="{Binding Index}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Name}" />
                    </TextBlock>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMuted}">
                      <Run Text="{Binding ProtocolLabel}" />
                      <Run Text=" · " />
                      <Run Text="{Binding EndpointText}" />
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding LiveStatusText}"
                               Foreground="{Binding LiveStatusBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding AuditBadgeText}"
                               Foreground="{Binding AuditBadgeBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding !ShowTechnicalDetails}"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10">
          <TextBlock Text="В Базовом режиме сырой JSON/конфиг скрыт для чистоты интерфейса. Переключите «Расширенный режим» вверху, чтобы редактировать конфиг вручную, открывать пресеты и сохранять локальную подписку."
                     FontSize="12"
                     Foreground="{StaticResource TextMuted}"
                     TextWrapping="Wrap" />
        </Border>

        <TextBox Text="{Binding RawConfig, Mode=TwoWay}"
                 IsVisible="{Binding ShowTechnicalDetails}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Watermark="Вставьте сюда ссылку на подписку (https://...), ключ vless://, hy2://, конфиг AmneziaWG или JSON..."
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="11.5" />
      </DockPanel>
    </Border>

    <!-- 5. Правая колонка: понятный разбор («Простыми словами» + спойлер техдеталей) -->
    <Border Grid.Row="3" Grid.Column="1" Classes="card" Padding="14">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Text="Что проверено и что это значит простыми словами" Classes="h2" VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Скопировать JSON узла"
                  Command="{Binding CopyOutboundJsonCommand}"
                  IsVisible="{Binding ShowTechnicalDetails}"
                  Padding="10,4" />
        </Grid>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AuditFindingDisplayItem">
                <Border Background="{StaticResource AppBackground}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <!-- Заголовок и статус -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Background="{StaticResource SurfaceAltBrush}"
                              CornerRadius="4"
                              Padding="7,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding SeverityLabel}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{Binding SeverityBrush}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 FontSize="13.5"
                                 FontWeight="SemiBold"
                                 Foreground="#FFFFFF"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <!-- Простыми словами (для работяги) -->
                    <TextBlock Text="{Binding SimpleSummary}"
                               FontSize="12.5"
                               Foreground="#D1DCF0"
                               TextWrapping="Wrap" />

                    <!-- Что сделать -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Что делать:" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" />
                      <TextBlock Text="{Binding Remediation}" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Кнопка-спойлер технических деталей -->
                    <Button Content="{Binding SpoilerButtonText}"
                            Command="{Binding ToggleExpandedCommand}"
                            HorizontalAlignment="Left"
                            Padding="8,3"
                            FontSize="11"
                            Foreground="{StaticResource TextMuted}"
                            Background="Transparent"
                            BorderThickness="0" />

                    <!-- Скрытый по умолчанию инженерный блок -->
                    <Border IsVisible="{Binding IsExpanded}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Технические подробности (для инженера):"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding TechnicalDetail}"
                                   FontSize="11.5"
                                   Foreground="#B8C5D9"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Evidence}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="#60A5FA"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
