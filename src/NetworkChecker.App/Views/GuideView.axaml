<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             x:Class="NetworkChecker.App.Views.GuideView"
             x:DataType="vm:GuideViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,18,24,28" Spacing="14">

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource LocMore61}" Classes="overline" />
          <TextBlock MaxWidth="980" Foreground="{DynamicResource TextMuted}">
            Здесь описано, что именно делает каждый модуль: какие данные читаются, как считается сигнал и что
            означает результат. Проект вдохновлён похожим Android-приложением RKNHardering (https://github.com/xtclovver/RKNHardering), не является его форком. На ПК вместо
            ConnectivityManager, dumpsys и PackageManager используются реестр Windows, NetworkInterface,
            PowerShell-командлеты (Get-NetRoute, Get-NetFirewallRule, Get-VpnConnection) и сетевые пробы.
          </TextBlock>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GuideSection">
            <Border Classes="card" Margin="0,0,0,14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}"
                          Margin="0,0,12,0">
                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes="h2" />
                    <TextBlock Text="{Binding Summary}" Classes="muted" MaxWidth="900" />
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GuideItem">
                      <Border Classes="inset" Width="430" Margin="0,0,12,12" Padding="12,10">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                            <Border Grid.Column="1" CornerRadius="999" Padding="8,2" Background="{Binding TagSoftBrush}">
                              <TextBlock Text="{Binding Tag}" FontSize="9.5" Foreground="{Binding TagBrush}" />
                            </Border>
                          </Grid>
                          <TextBlock Text="{Binding Body}" Classes="muted" FontSize="11.5" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
