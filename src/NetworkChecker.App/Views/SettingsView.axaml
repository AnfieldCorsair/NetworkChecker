<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             xmlns:local="using:NetworkChecker.App"
             x:Class="NetworkChecker.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,18,24,28" Spacing="16">
      <TextBlock Text="{DynamicResource SettingsLegal}" Classes="muted" TextWrapping="Wrap" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource SettingsLanguageTitle}" Classes="overline" />
          <TextBlock Text="{DynamicResource LanguageNotice}" Classes="muted" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="180" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <!-- Поведение -->
        <Border Grid.Column="0" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource LocExtra0}" Classes="overline" />
            <Grid ColumnDefinitions="*,96" Margin="0,2">
              <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LocExtra1}" FontSize="12.5" />
                <TextBlock Text="{DynamicResource LocExtra2}" Classes="muted" FontSize="10.5" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" Value="{Binding RequestTimeout}" Minimum="2" Maximum="60" Increment="1"
                             FormatString="0" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,96" Margin="0,2">
              <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LocExtra3}" FontSize="12.5" />
                <TextBlock Text="{DynamicResource LocExtra4}" Classes="muted" FontSize="10.5" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" Value="{Binding MaxParallelChecks}" Minimum="1" Maximum="12" Increment="1"
                             FormatString="0" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,96" Margin="0,2">
              <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LocExtra5}" FontSize="12.5" />
                <TextBlock Text="{DynamicResource LocExtra6}" Classes="muted" FontSize="10.5" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" Value="{Binding MaxTraceHops}" Minimum="1" Maximum="64" Increment="1"
                             FormatString="0" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,220" Margin="0,2">
              <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LocExtra7}" FontSize="12.5" />
                <TextBlock Text="{DynamicResource LocExtra8}" Classes="muted" FontSize="10.5" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding DefaultTraceTarget}" FontSize="12" />
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,4" />

            <StackPanel Spacing="8">
              <CheckBox Content="{DynamicResource LocExtra9}" IsChecked="{Binding PrivacyMode}" FontSize="12.5" />
              <CheckBox Content="{DynamicResource LocExtra10}" IsChecked="{Binding OfflineMode}" FontSize="12.5" />
              <CheckBox Content="{DynamicResource LocExtra11}" IsChecked="{Binding SaveHistory}" FontSize="12.5" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{DynamicResource LocExtra12}" FontSize="12.5" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="150" FontSize="12" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Данные -->
        <StackPanel Grid.Column="1" Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource LocExtra13}" Classes="overline" />
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource LocExtra14}" Classes="muted" FontSize="10.5" />
                <TextBlock Text="{Binding DataDirectory}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{DynamicResource LocExtra15}" Classes="muted" FontSize="10.5" />
                <TextBlock Text="{Binding DatabasePath}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Command="{Binding OpenDataFolderCommand}" FontSize="12">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Data="{x:Static local:Icons.Folder}" Stretch="Uniform" Width="12" Height="12"
                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LocExtra16}" FontSize="12" />
                  </StackPanel>
                </Button>
                <Button Classes="danger" Command="{Binding ClearHistoryCommand}" FontSize="12" Content="{DynamicResource LocExtra17}" />
              </StackPanel>
              <TextBlock Text="{Binding DbStatus}" Classes="muted" FontSize="10.5" />
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding Mode.IsPro}">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource LocExtra18}" Classes="overline" />
              <TextBlock Text="{DynamicResource LocExtra19}" Classes="muted" FontSize="10.5" />
              <TextBox Text="{Binding GeoIpProviders}" AcceptsReturn="True" Height="92" FontSize="11" Classes="mono"
                       TextWrapping="Wrap" VerticalContentAlignment="Top" />
              <TextBlock Text="{DynamicResource LocExtra20}" Classes="muted" FontSize="10.5" />
              <TextBox Text="{Binding ReachabilityTargets}" AcceptsReturn="True" Height="86" FontSize="11" Classes="mono"
                       TextWrapping="Wrap" VerticalContentAlignment="Top" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="{DynamicResource LocExtra21}" Classes="muted" FontSize="10.5" />
                  <TextBox Text="{Binding RttRussianHosts}" AcceptsReturn="True" Height="76" FontSize="11" Classes="mono"
                           TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{DynamicResource LocExtra22}" Classes="muted" FontSize="10.5" />
                  <TextBox Text="{Binding RttForeignHosts}" AcceptsReturn="True" Height="76" FontSize="11" Classes="mono"
                           TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource LocExtra23}" Classes="muted" FontSize="10.5" />
              <TextBox Text="{Binding StunServers}" AcceptsReturn="True" Height="64" FontSize="11" Classes="mono"
                       TextWrapping="Wrap" VerticalContentAlignment="Top" />
              <TextBlock Text="{DynamicResource LocExtra24}" Classes="muted" FontSize="10.5" />
              <TextBox Text="{Binding LocalProxyPorts}" FontSize="11" Classes="mono" Height="60" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalContentAlignment="Top" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Classes="card" Padding="14">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding SaveStatus}" Classes="muted" VerticalAlignment="Center" FontSize="11.5" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding ResetToDefaultsCommand}" Content="{DynamicResource LocExtra25}" Margin="0,0,8,0" FontSize="12" />
          <Button Grid.Column="2" Classes="primary" Command="{Binding SaveCommand}" Content="{DynamicResource LocExtra26}" FontSize="12" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
