<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             x:Class="NetworkChecker.App.Views.TspuFingerprintsView"
             x:DataType="vm:TspuFingerprintsViewModel">

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="7*,5*" ColumnSpacing="16" RowSpacing="12" Margin="20,14">
    <!-- Панель запуска -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="card" Padding="14,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Автоматическая проверка ограничений вашего провайдера (ТСПУ, лимит 16 КБ и подмена DNS)" Classes="h2" />
          <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#93C5FD" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Запустить проверку линии"
                  Classes="primary"
                  Command="{Binding RunScanCommand}"
                  IsEnabled="{Binding !IsScanning}"
                  Padding="16,8" />
          <Button Content="Скопировать результат" Command="{Binding CopySummaryCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Левая колонка: распознанные ограничения простыми словами + спойлер техдеталей -->
    <Border Grid.Row="1" Grid.Column="0" Classes="card" Padding="14">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="Что обнаружено на вашей интернет-линии и что делать" Classes="h2" Margin="0,0,0,10" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Fingerprints}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FingerprintDisplayItem">
                <Border Background="{StaticResource AppBackground}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,8">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Mechanism}" FontSize="12.5" Foreground="#D1DCF0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Recommendation}" FontSize="12" Foreground="#93C5FD" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <Button Content="{Binding SpoilerButtonText}"
                            Command="{Binding ToggleExpandedCommand}"
                            HorizontalAlignment="Left"
                            Padding="6,2"
                            FontSize="11"
                            Foreground="{StaticResource TextMuted}"
                            Background="Transparent"
                            BorderThickness="0" />

                    <Border IsVisible="{Binding IsExpanded}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,6">
                      <TextBlock Text="{Binding EvidenceText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#60A5FA" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Правая колонка: матрица целей + ступенчатый тест 16 КБ -->
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
      <Border Grid.Row="0" Classes="card" Padding="14">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="Какие сайты открываются напрямую" Classes="h2" Margin="0,0,0,10" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Targets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetDisplayItem">
                  <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                          <Run Text="{Binding Host}" />
                          <Run Text=" · " />
                          <Run Text="{Binding GroupLabel}" />
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Проверка обрыва связи после 16 килобайт (лимит ТСПУ)" Classes="h2" />
          <ItemsControl ItemsSource="{Binding CutoffSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CutoffDisplayItem">
                <Grid ColumnDefinitions="110,*" Margin="0,2">
                  <TextBlock Text="{Binding StepLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
