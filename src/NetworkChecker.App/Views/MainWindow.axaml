<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetworkChecker.App.ViewModels"
        x:Class="NetworkChecker.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Контур ВПН — NetworkChecker V2"
        Width="1200"
        Height="740"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- ВЕРХНЯЯ ПЛАШКА НАВИГАЦИИ -->
    <Border Grid.Row="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="0,0,0,1"
            Padding="20,12">
      <StackPanel Spacing="12">
        <!-- Верхний ряд: бренд + переключатель Простой / Инженерный режим -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Контур ВПН" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    VerticalAlignment="Center">
              <TextBlock Text="NetworkChecker V2 · Подписки Happ / VLESS / AWG / HY2"
                         FontSize="11.5"
                         Foreground="#93C5FD" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Отображение проверок:" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            <Button Content="{Binding ModeButtonLabel}"
                    Command="{Binding ToggleModeCommand}"
                    Classes="primary"
                    Padding="14,7" />
          </StackPanel>
        </Grid>

        <!-- Ряд кнопок-вкладок верхней навигации (5 разделов) -->
        <ItemsControl ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav"
                      Classes.selected="{Binding IsSelected}"
                      Command="{Binding SelectCommand}"
                      Margin="0,0,8,0"
                      Padding="12,10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding StepBadge}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="10"
                             FontWeight="Bold"
                             Foreground="#60A5FA" />
                  <TextBlock Text="{Binding Title}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Subtitle}"
                             FontSize="11"
                             Foreground="{StaticResource TextSubtle}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ПОЯСНЯЮЩАЯ ПЛАШКА ДЛЯ ПОЛЬЗОВАТЕЛЯ («ЧТО И ЗАЧЕМ ПРОВЕРЯЕТСЯ») -->
    <Border Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="0,0,0,1"
            Padding="22,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding CurrentPage.Title}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" />
            <TextBlock Text="· Что здесь проверяется и что нажимать:" FontSize="13" Foreground="#93C5FD" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding CurrentPage.SimpleGuideText}"
                     FontSize="12.5"
                     Foreground="#D1DCF0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ ВКЛАДКИ -->
    <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
  </Grid>
</Window>
