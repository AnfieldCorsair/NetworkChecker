<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetworkChecker.App.ViewModels"
        x:Class="NetworkChecker.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Контур ВПН — NetworkChecker V2"
        Width="1320"
        Height="840"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="240,*">
    <!-- Левая боковая панель навигации -->
    <Border Grid.Column="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="0,0,1,0"
            Padding="14,18">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Бренд -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="8,0,8,20">
          <TextBlock Text="Контур ВПН" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
          <TextBlock Text="NetworkChecker V2 · Десктоп" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
        </StackPanel>

        <!-- 5 вкладок -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav"
                      Classes.selected="{Binding IsSelected}"
                      Command="{Binding SelectCommand}"
                      Margin="0,0,0,4">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}"
                             FontSize="13" />
                  <TextBlock Text="{Binding Subtitle}"
                             FontSize="11"
                             Foreground="{StaticResource TextSubtle}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Нижняя строка версии -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="8,12,8,0">
          <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,8" />
          <TextBlock Text="v2.0.0 · .NET 10 · Avalonia 12" FontSize="11" Foreground="{StaticResource TextSubtle}" />
          <TextBlock Text="Фокус РФ: VLESS · AWG · HY2" FontSize="11" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Основная рабочая область -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush2}"
              BorderThickness="0,0,0,1"
              Padding="24,16">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding CurrentPage.Title}" Classes="h1" />
          <TextBlock Text="{Binding CurrentPage.Description}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
