<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             xmlns:net="using:NetworkChecker.Core.Net"
             xmlns:local="using:NetworkChecker.App"
             x:Class="NetworkChecker.App.Views.NetworkView"
             x:DataType="vm:NetworkViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Панель управления: только в подробном режиме, в простом всё нужное — в карточке ниже -->
    <Border Grid.Row="0" Classes="card" Margin="24,18,24,0" Padding="14" IsVisible="{Binding Mode.IsPro}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowTabs}">
          <Button Content="{DynamicResource LocOverview}" Command="{Binding SelectTabCommand}" CommandParameter="Овервью" FontSize="12"
                  Padding="12,6" Classes.primary="{Binding ShowOverview}" />
          <Button Content="{DynamicResource LocDiagnostics}" Command="{Binding SelectTabCommand}" CommandParameter="Диагностика" FontSize="12"
                  Padding="12,6" Classes.primary="{Binding ShowDiagnostics}" />
          <Button Content="{DynamicResource LocTrace}" Command="{Binding SelectTabCommand}" CommandParameter="Трассировка" FontSize="12"
                  Padding="12,6" Classes.primary="{Binding ShowTrace}" />
        </StackPanel>
        <SelectableTextBlock Grid.Column="2" Text="{Binding StatusLine}" Classes="muted" VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Command="{Binding RefreshOverviewCommand}" FontSize="12" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{x:Static local:Icons.Refresh}" Stretch="Uniform" Width="12" Height="12"
                    Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource LocRefresh}" FontSize="12" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding RunDiagnosticsCommand}" FontSize="12" Padding="12,6"
                  Content="{DynamicResource LocDiagnostics}" IsVisible="{Binding ShowTabs}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= Овервью: простой режим ================= -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowSimpleOverview}">
      <StackPanel Margin="24,16,24,28" Spacing="16">
        <Border Classes="card" Padding="0">
          <Grid ColumnDefinitions="6,*">
            <Border Grid.Column="0" CornerRadius="12,0,0,12" Background="{Binding SimpleToneBrush}" />
            <StackPanel Grid.Column="1" Margin="20,18" Spacing="10">
              <TextBlock Text="{DynamicResource LocMore22}" Classes="overline" />
              <SelectableTextBlock Text="{Binding SimpleSummary}" Classes="h1" FontSize="22" />
              <TextBlock Text="{DynamicResource LocMore23}"
                         Classes="muted" MaxWidth="780" HorizontalAlignment="Left" />
              <Button Classes="primary" Command="{Binding RefreshOverviewCommand}" HorizontalAlignment="Left" Padding="16,9">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Data="{x:Static local:Icons.Refresh}" Stretch="Uniform" Width="12" Height="12"
                        Stroke="White" StrokeThickness="1.8" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource LocExtra28}" Foreground="White" FontSize="12.5" />
                </StackPanel>
              </Button>
              <SelectableTextBlock Text="{Binding StatusLine}" Classes="muted" FontSize="11" />
            </StackPanel>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding SimpleFacts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SimpleNetFact">
              <Border Classes="card" Width="440" Margin="0,0,14,14" Padding="14,12">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                    <SelectableTextBlock Text="{Binding Label}" Classes="overline" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" />
                  <SelectableTextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= Овервью: подробный режим ================= -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowTechnicalOverview}">
      <StackPanel Margin="24,16,24,28" Spacing="16">

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
          <Border Grid.Column="0" Classes="card" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource LocMore10}" Classes="overline" />
              <SelectableTextBlock Text="{Binding ExternalIp}" FontSize="19" FontWeight="SemiBold" Classes="mono" />
              <SelectableTextBlock Text="{Binding ExternalDetails}" Classes="muted" FontSize="10.5" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource LocMore24}" Classes="overline" />
              <SelectableTextBlock Text="{Binding StunText}" FontSize="19" FontWeight="SemiBold" Classes="mono" />
              <TextBlock Text="{DynamicResource LocMore25}" Classes="muted" FontSize="10.5" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource LocMore26}" Classes="overline" />
              <SelectableTextBlock Text="{Binding ProxyText}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource LocMore27}" Classes="muted" FontSize="10.5" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="card" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource LocMore28}" Classes="overline" />
              <SelectableTextBlock Text="{Binding AdaptersCountText}" FontSize="19" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding MtuText, StringFormat='MTU основного: {0}'}" Classes="muted" FontSize="10.5" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <!-- Ключевые параметры -->
          <Border Grid.Column="0" Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource LocMore29}" Classes="overline" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding OverviewRefreshed}" Classes="muted" FontSize="10.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Overview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyValueRow">
                    <Grid ColumnDefinitions="190,*" Margin="0,5">
                      <SelectableTextBlock Grid.Column="0" Text="{Binding Key}" Classes="muted" FontSize="12" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <SelectableTextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Hint}" Classes="muted" FontSize="10" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Маршруты -->
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource LocMore30}" Classes="overline" />
              <Grid ColumnDefinitions="112,120,*,52">
                <TextBlock Grid.Column="0" Text="{DynamicResource LocMore31}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocMore32}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="2" Text="{DynamicResource LocMore33}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="3" Text="{DynamicResource LocMore34}" Classes="muted" FontSize="10.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding DefaultRoutes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RouteRowViewModel">
                    <Grid ColumnDefinitions="112,120,*,52" Margin="0,3">
                      <SelectableTextBlock Grid.Column="0" Text="{Binding Destination}" Classes="mono" FontSize="11"
                                 Foreground="{Binding IsDefault, Converter={x:Static vm:Converters.DefaultRouteBrush}}" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding GatewayText}" Classes="mono" FontSize="11" />
                      <SelectableTextBlock Grid.Column="2" Text="{Binding InterfaceName}" FontSize="11" />
                      <SelectableTextBlock Grid.Column="3" Text="{Binding MetricText}" Classes="mono" FontSize="11"
                                 Foreground="{DynamicResource TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Адаптеры -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource LocMore35}" Classes="overline" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="990" Spacing="4">
            <Grid ColumnDefinitions="150,80,150,130,44,150,1.4*">
              <TextBlock Grid.Column="0" Text="{DynamicResource LocMore36}" Classes="muted" FontSize="10.5" />
              <TextBlock Grid.Column="1" Text="{DynamicResource LocMore37}" Classes="muted" FontSize="10.5" />
              <TextBlock Grid.Column="2" Text="{DynamicResource LocMore38}" Classes="muted" FontSize="10.5" />
              <TextBlock Grid.Column="3" Text="{DynamicResource LocMore32}" Classes="muted" FontSize="10.5" />
              <TextBlock Grid.Column="4" Text="MTU" Classes="muted" FontSize="10.5" />
              <TextBlock Grid.Column="5" Text="DNS" Classes="muted" FontSize="10.5" />
              <TextBlock Grid.Column="6" Text="{DynamicResource LocMore39}" Classes="muted" FontSize="10.5" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Adapters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AdapterRowViewModel">
                  <Grid ColumnDefinitions="150,80,150,130,44,150,1.4*" Margin="0,4">
                    <Grid Grid.Column="0" ColumnDefinitions="12,*">
                      <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding KindBrush}" VerticalAlignment="Top" Margin="0,4,6,0" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" />
                    </Grid>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="11" Foreground="{Binding KindBrush}" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding AddressText}" Classes="mono" FontSize="10.5" />
                    <SelectableTextBlock Grid.Column="3" Text="{Binding GatewayText}" Classes="mono" FontSize="10.5" />
                    <SelectableTextBlock Grid.Column="4" Text="{Binding MtuText}" Classes="mono" FontSize="10.5" />
                    <SelectableTextBlock Grid.Column="5" Text="{Binding DnsText}" Classes="mono" FontSize="10.5" />
                    <SelectableTextBlock Grid.Column="6" Text="{Binding Description}" Classes="muted" FontSize="10.5" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= Диагностика ================= -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowDiagnostics}">
      <StackPanel Margin="24,16,24,28" Spacing="16">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <Border Grid.Column="0" Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource LocMore40}" Classes="overline" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding DiagnosticsRefreshed}" Classes="muted" FontSize="10.5" />
              </Grid>
              <Grid ColumnDefinitions="1.2*,1.2*,80,70,60,60,70">
                <TextBlock Grid.Column="0" Text="{DynamicResource LocMore41}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="1" Text="{DynamicResource LocMore38}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="2" Text="{DynamicResource LocMore42}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="3" Text="Jitter" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="4" Text="{DynamicResource LocMore43}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="5" Text="{DynamicResource LocMore44}" Classes="muted" FontSize="10.5" />
                <TextBlock Grid.Column="6" Text="{DynamicResource LocMore45}" Classes="muted" FontSize="10.5" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Latency}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LatencyRowViewModel">
                    <Grid ColumnDefinitions="1.2*,1.2*,80,70,60,60,70" Margin="0,4">
                      <SelectableTextBlock Grid.Column="0" Text="{Binding Host}" FontSize="11.5" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Address}" Classes="mono" FontSize="10.5" />
                      <SelectableTextBlock Grid.Column="2" Text="{Binding MedianText}" Classes="mono" FontSize="11" />
                      <SelectableTextBlock Grid.Column="3" Text="{Binding JitterText}" Classes="mono" FontSize="10.5"
                                 Foreground="{DynamicResource TextMuted}" />
                      <SelectableTextBlock Grid.Column="4" Text="{Binding LossText}" Classes="mono" FontSize="10.5" />
                      <SelectableTextBlock Grid.Column="5" Text="{Binding MethodText}" FontSize="10"
                                 Foreground="{DynamicResource TextMuted}" />
                      <SelectableTextBlock Grid.Column="6" Text="{Binding StatusText}" FontSize="10.5"
                                 Foreground="{DynamicResource TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,4" />
              <TextBlock Text="{DynamicResource LocMore46}" Classes="overline" />
              <ItemsControl ItemsSource="{Binding Mtu}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MtuRowViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                      <SelectableTextBlock Grid.Column="0" Text="{Binding Target}" FontSize="11.5" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding ResultText}" Classes="mono" FontSize="11" Margin="0,0,10,0" />
                      <Border Grid.Column="2" Classes="chip" IsVisible="{Binding Suspicious}">
                        <TextBlock Text="{DynamicResource LocMore47}" FontSize="9.5" Foreground="{DynamicResource NoticeBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Spacing="16">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource LocMore48}" Classes="overline" />
                <Grid ColumnDefinitions="1.3*,1*,90,60">
                  <TextBlock Grid.Column="0" Text="{DynamicResource LocMore49}" Classes="muted" FontSize="10.5" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource LocMore50}" Classes="muted" FontSize="10.5" />
                  <TextBlock Grid.Column="2" Text="{DynamicResource LocMore51}" Classes="muted" FontSize="10.5" />
                  <TextBlock Grid.Column="3" Text="{DynamicResource LocMore45}" Classes="muted" FontSize="10.5" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Dns}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DnsRowViewModel">
                      <Grid ColumnDefinitions="1.3*,1*,90,60" Margin="0,4">
                        <SelectableTextBlock Grid.Column="0" Text="{Binding Server}" Classes="mono" FontSize="10.5" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Answer}" Classes="mono" FontSize="10.5" />
                        <SelectableTextBlock Grid.Column="2" Text="{Binding ElapsedText}" Classes="mono" FontSize="10.5" />
                        <SelectableTextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMuted}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource LocMore52}" Classes="overline" />
                <ItemsControl ItemsSource="{Binding Tls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TlsRowViewModel">
                      <StackPanel Spacing="1" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto">
                          <SelectableTextBlock Grid.Column="0" Text="{Binding Host}" FontSize="11.5" FontWeight="SemiBold" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Protocol}" Classes="muted" FontSize="10" />
                        </Grid>
                        <SelectableTextBlock Text="{Binding IssuerShort}" Classes="muted" FontSize="10.5" />
                        <SelectableTextBlock Text="{Binding ValidationText}" Classes="muted" FontSize="10" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= Трассировка ================= -->
    <Grid Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowTrace}" RowDefinitions="Auto,*" Margin="24,16,24,28">
      <Border Grid.Row="0" Classes="card" Padding="14">
        <Grid ColumnDefinitions="Auto,240,Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="{DynamicResource LocTarget}" Classes="muted" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Grid.Column="1" Text="{Binding TraceTarget}" PlaceholderText="1.1.1.1" FontSize="12" />
          <Button Grid.Column="2" Classes="primary" Command="{Binding RunTraceCommand}" Margin="10,0,0,0" FontSize="12">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{x:Static local:Icons.Trace}" Stretch="Uniform" Width="12" Height="12"
                    Stroke="White" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource LocTraceAction}" Foreground="White" FontSize="12" />
            </StackPanel>
          </Button>
          <SelectableTextBlock Grid.Column="3" Text="{Binding TraceStatus}" Classes="muted" VerticalAlignment="Center"
                     HorizontalAlignment="Center" />
          <Button Grid.Column="4" Classes="danger" Command="{Binding CancelTraceCommand}" FontSize="12" Content="{DynamicResource LocStop}" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="card" Margin="0,16,0,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource LocGraph}" Classes="overline" />
            <TextBlock Text="{DynamicResource LocGraphHint}" Classes="muted" TextWrapping="Wrap" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Hops}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TraceHopViewModel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text=" → " Classes="muted" FontSize="16" IsVisible="{Binding HasPrevious}" />
                      <Border BorderBrush="{Binding AsnBrush}" BorderThickness="1" CornerRadius="8" Padding="10" MinWidth="150" Background="{DynamicResource AppBackground}">
                        <StackPanel Spacing="3">
                          <SelectableTextBlock Text="{Binding IndexText}" Foreground="{Binding AsnBrush}" FontWeight="Bold" FontSize="11" />
                          <SelectableTextBlock Text="{Binding HostText}" Classes="mono" FontSize="11" />
                          <SelectableTextBlock Text="{Binding AsnLabel}" Foreground="{Binding AsnBrush}" FontSize="11" />
                          <SelectableTextBlock Text="{Binding RttText}" Classes="muted" FontSize="10" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="44,180,110,90,2*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="#" Classes="muted" FontSize="10.5" />
            <TextBlock Grid.Column="1" Text="{DynamicResource LocHop}" Classes="muted" FontSize="10.5" />
            <TextBlock Grid.Column="2" Text="{DynamicResource LocRtt}" Classes="muted" FontSize="10.5" />
            <TextBlock Grid.Column="3" Text="ASN" Classes="muted" FontSize="10.5" />
            <TextBlock Grid.Column="4" Text="{DynamicResource LocOperator}" Classes="muted" FontSize="10.5" />
          </Grid>
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Hops}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TraceHopViewModel">
                  <Grid ColumnDefinitions="44,180,110,90,2*" Margin="0,4">
                    <SelectableTextBlock Grid.Column="0" Text="{Binding Index}" Classes="mono" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding HostText}" Classes="mono" FontSize="11" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding RttText}" Classes="mono" FontSize="11" />
                    <SelectableTextBlock Grid.Column="3" Text="{Binding Asn}" Classes="mono" FontSize="11"
                               Foreground="{Binding AsnBrush}" />
                    <SelectableTextBlock Grid.Column="4" Text="{Binding AsName}" FontSize="11" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
