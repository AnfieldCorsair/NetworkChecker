<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels" xmlns:cap="using:NetworkChecker.Core.Capture"
             x:Class="NetworkChecker.App.Views.CaptureView" x:DataType="vm:CaptureViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,18,24,28" Spacing="14">
      <Border Classes="card"><StackPanel Spacing="10">
        <TextBlock Text="{DynamicResource CaptureTitle}" Classes="h2" />
        <TextBlock Text="{DynamicResource CaptureIntro}" Classes="muted" />
        <TextBlock Text="{DynamicResource CapturePrivacy}" Classes="muted" />
        <Button Content="{DynamicResource CaptureOpen}" Click="OpenCapture" HorizontalAlignment="Left" />
        <SelectableTextBlock Text="{Binding Status}" />
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource CapturePackets}" Classes="overline" />
        <TextBlock Text="{DynamicResource CaptureLimits}" Classes="muted" />
        <ListBox ItemsSource="{Binding Packets}" SelectedItem="{Binding Selected}" Height="360">
          <ListBox.ItemTemplate><DataTemplate x:DataType="cap:CapturePacket">
            <Grid ColumnDefinitions="105,*,*,95" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding Protocol}" />
              <TextBlock Grid.Column="1" Text="{Binding Source}" Classes="mono" />
              <TextBlock Grid.Column="2" Text="{Binding Destination}" Classes="mono" />
              <TextBlock Grid.Column="3" Text="{Binding CapturedBytes, StringFormat='{}{0} B'}" />
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource CaptureBytes}" Classes="overline" />
        <SelectableTextBlock Text="{Binding Selected.HexPreview}" Classes="mono" />
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
