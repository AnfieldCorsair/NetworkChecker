<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             x:Class="NetworkChecker.App.Views.SupportTicketView"
             x:DataType="vm:SupportTicketViewModel">

  <Grid ColumnDefinitions="5*,7*" ColumnSpacing="16" Margin="20">

    <!-- Левая колонка: 2-шаговый сбор срезов и поля тикета -->
    <Border Grid.Column="0" Classes="card">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <TextBlock Text="1. Сбор двух срезов сети" Classes="h2" />

          <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Шаг 1 · Без ВПН (фиксация РФ-провайдера)" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Снять срез" Classes="primary" Command="{Binding CaptureWithoutVpnCommand}" IsEnabled="{Binding !IsBusy}" />
              </Grid>
              <TextBlock Text="{Binding WithoutVpnSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Шаг 2 · С включённым ВПН (туннель)" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Снять срез" Classes="primary" Command="{Binding CaptureWithVpnCommand}" IsEnabled="{Binding !IsBusy}" />
              </Grid>
              <TextBlock Text="{Binding WithVpnSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Height="1" Background="{StaticResource BorderBrush2}" />

          <TextBlock Text="2. Описание проблем для оператора" Classes="h2" />

          <StackPanel Spacing="6">
            <TextBlock Text="Отметьте одну или несколько проблем с интернетом / ВПН:" Classes="muted" />
            <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8">
              <ItemsControl ItemsSource="{Binding SymptomItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SelectableSymptomItem">
                    <CheckBox Content="{Binding Label}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Тип подключения" Classes="muted" />
            <ComboBox ItemsSource="{Binding ConnectionChoices}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Клиент ВПН" Classes="muted" />
            <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Комментарий (UUID и ключи маскируются автоматически)" Classes="muted" />
            <TextBox Text="{Binding UserComment, Mode=TwoWay}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Watermark="Например: началось сегодня с 18:00 на Ростелекоме..." />
          </StackPanel>

          <CheckBox Content="Скрывать последние два октета домашнего IP (xx.xx.xxx.xxx)" IsChecked="{Binding MaskHomeIp, Mode=TwoWay}" />

          <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="#93C5FD" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Правая колонка: готовое сообщение для Telegram + экспорт .md -->
    <Border Grid.Column="1" Classes="card" Padding="14">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Text="Готовое обращение для Telegram-бота / чата поддержки" Classes="h2" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Обновить стек ОС"
                    Command="{Binding RefreshOsStackCommand}"
                    IsVisible="{Binding ShowTechnicalDetails}" />
            <Button Content="Копировать текст" Classes="primary" Command="{Binding CopyTelegramCommand}" />
            <Button Content="Сохранить .md"
                    Command="{Binding SaveMarkdownCommand}"
                    IsVisible="{Binding ShowTechnicalDetails}" />
          </StackPanel>
        </Grid>

        <TextBox Text="{Binding TelegramPreview, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="12" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
