<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             x:Class="NetworkChecker.App.Views.IpReputationView"
             x:DataType="vm:IpReputationViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22" Spacing="18">

      <!-- Заголовок и быстрые действия -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Репутация IP, метка Google RU и сканер всех IP подписки" />
          <TextBlock Classes="subtitle"
                     Text="Консенсус 4 независимых GeoIP-баз (Majority Vote по Hosting, Any Vote по Proxy/VPN), живой зонд прокажённой метки RU у Google/YouTube и пакетная проверка всех серверов подписки" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
          <Button Content="Подставить IP выбранного узла"
                  Command="{Binding FillManualFromActiveNodeCommand}" />
          <Button Content="Скопировать отчёт по IP"
                  Command="{Binding CopyReputationReportCommand}" />
        </StackPanel>
      </Grid>

      <!-- Панель выбора режима и запуска проверки -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Режим проверки активного соединения или выбранного IP:"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="#D1DCF0" />
              <ComboBox ItemsSource="{Binding RoutingModeOptions}"
                        SelectedIndex="{Binding SelectedRoutingModeIndex}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="primary"
                    VerticalAlignment="Bottom"
                    Padding="16,9"
                    Command="{Binding RunActiveInspectionCommand}"
                    IsEnabled="{Binding !IsInspectingActive}"
                    Content="Проверить активный IP и реакцию Google" />

            <Button Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Padding="16,9"
                    Command="{Binding ScanSubscriptionIpsCommand}"
                    IsEnabled="{Binding !IsScanningSubscription}"
                    Content="Достать и проверить все IP из подписки" />
          </Grid>

          <!-- Поле ручного ввода IP или домена (видно в режиме 3) -->
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10"
                IsVisible="{Binding IsManualTargetVisible}">
            <TextBlock Text="IP или домен сервера:"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="#93C5FD" />
            <TextBox Grid.Column="1"
                     Text="{Binding ManualTargetInput}"
                     Watermark="Например: 185.220.101.5 или nl1.example.com" />
            <Button Grid.Column="2"
                    Content="Взять из вкладки 1"
                    Command="{Binding FillManualFromActiveNodeCommand}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding ActiveInspectionStatus}"
                       FontSize="12.5"
                       Foreground="#93C5FD"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CopyFeedback}"
                       FontSize="12"
                       Foreground="{StaticResource SuccessBrush}"
                       IsVisible="{Binding CopyFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Основная рабочая сетка: Слева (Активный IP + Вердикт Google RU + 4 провайдера), Справа (Все IP из подписки) -->
      <Grid ColumnDefinitions="5*,6*" ColumnSpacing="18">

        <!-- ЛЕВАЯ КОЛОНКА: Активный IP, реакция Google RU и 4 базы GeoIP -->
        <StackPanel Grid.Column="0" Spacing="14">

          <!-- Карточка вердикта Google / YouTube RU Geo-Poisoning -->
          <Border Classes="card"
                  BorderBrush="{Binding GoogleVerdictBorderBrush}"
                  BorderThickness="1.5">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="ДЕТЕКТОР «ПРОКАЖЁННОЙ МЕТКИ RU» У GOOGLE И YOUTUBE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#93C5FD" />
                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,3">
                  <TextBlock Text="{Binding DetectedGlBadge}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             Foreground="#E2E8F0" />
                </Border>
              </Grid>

              <TextBlock Text="{Binding GoogleVerdictTitle}"
                         FontSize="15.5"
                         FontWeight="Bold"
                         Foreground="{Binding GoogleVerdictTitleBrush}"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding GoogleVerdictSummary}"
                         FontSize="12.5"
                         Foreground="#E2E8F0"
                         TextWrapping="Wrap" />

              <Border Background="{StaticResource SurfaceAltBrush}"
                      CornerRadius="6"
                      Padding="10,8">
                <TextBlock Text="{Binding GoogleVerdictEvidence}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11.5"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Карточка сводного консенсуса по активному IP -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="КОНСЕНСУС 4 БАЗ ПО ТЕКУЩЕМУ IP"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{StaticResource TextSubtle}" />
                  <TextBlock Text="{Binding DetectedExitIp}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="18"
                             FontWeight="Bold"
                             Foreground="#FFFFFF" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                  <TextBlock Text="{Binding PhysicalGeoBadge}"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Foreground="#93C5FD"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding DetectedAsnBadge}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11.5"
                             Foreground="{StaticResource TextMuted}"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>

              <WrapPanel Orientation="Horizontal">
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9,5"
                        Margin="0,0,8,8">
                  <TextBlock Text="{Binding MajorityHostingBadge}"
                             FontSize="11.5"
                             FontWeight="SemiBold"
                             Foreground="{Binding MajorityHostingBrush}" />
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9,5"
                        Margin="0,0,8,8">
                  <TextBlock Text="{Binding AnyProxyBadge}"
                             FontSize="11.5"
                             FontWeight="SemiBold"
                             Foreground="{Binding AnyProxyBrush}" />
                </Border>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9,5"
                        Margin="0,0,0,8">
                  <TextBlock Text="{Binding IpConsistencyBadge}"
                             FontSize="11.5"
                             FontWeight="SemiBold"
                             Foreground="{Binding IpConsistencyBrush}" />
                </Border>
              </WrapPanel>

              <!-- Таблица 4 провайдеров GeoIP -->
              <ItemsControl ItemsSource="{Binding ProviderItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GeoProviderDisplayItem">
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,9"
                            Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding ProviderName}"
                                     FontWeight="Bold"
                                     FontSize="13"
                                     Foreground="#FFFFFF" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Ip}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12"
                                     Foreground="#93C5FD" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding StatusText}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11"
                                     Foreground="{StaticResource TextSubtle}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding CountryDisplay}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="#E2E8F0" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding HostingBadge}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding HostingBrush}" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding ProxyBadge}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding ProxyBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding AsnOrgDisplay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА: Все IP из подписки (Пакетный экстрактор и сканер репутации) -->
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="ВСЕ IP ИЗ ВАШЕЙ ПОДПИСКИ (ПАКЕТНЫЙ АУДИТ ПОДСЕТЕЙ)"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#93C5FD" />
                <TextBlock Text="Автоматически достаёт все узлы из подписки Happ / JSON-балансировщика / VLESS / HY2, разрешает домены в реальные IP и проверяет их ASN, риск метки RU у Google и риск ТСПУ 16 КБ"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,9">
              <TextBlock Text="{Binding SubscriptionIpSummary}"
                         FontSize="12.5"
                         Foreground="#E2E8F0"
                         TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding SubscriptionIpItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionIpDisplayItem">
                  <Border Background="{StaticResource SurfaceAltBrush}"
                          BorderBrush="{StaticResource BorderBrush2}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="12,10"
                          Margin="0,0,0,9">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap" />
                        <Border Grid.Column="1"
                                Background="#1E293B"
                                CornerRadius="4"
                                Padding="7,2">
                          <TextBlock Text="{Binding ProtocolAndPort}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11"
                                     Foreground="#93C5FD" />
                        </Border>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding HostAndResolvedIp}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   Foreground="#93C5FD"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountryDisplay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0" />
                      </Grid>

                      <TextBlock Text="{Binding AsnOrgDisplay}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11.5"
                                 Foreground="{StaticResource TextMuted}"
                                 TextWrapping="Wrap" />

                      <WrapPanel Orientation="Horizontal">
                        <Border Background="#111827"
                                CornerRadius="4"
                                Padding="7,3"
                                Margin="0,0,8,4">
                          <TextBlock Text="{Binding GoogleRuBleedBadge}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding GoogleRuBleedBrush}" />
                        </Border>

                        <Border Background="#111827"
                                CornerRadius="4"
                                Padding="7,3"
                                Margin="0,0,8,4">
                          <TextBlock Text="{Binding Cloud16KbBadge}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding Cloud16KbBrush}" />
                        </Border>

                        <Border Background="#111827"
                                CornerRadius="4"
                                Padding="7,3"
                                Margin="0,0,0,4">
                          <TextBlock Text="{Binding HostingProxyBadges}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11"
                                     Foreground="#CBD5E1" />
                        </Border>
                      </WrapPanel>

                      <TextBlock Text="{Binding SummaryNote}"
                                 FontSize="12"
                                 Foreground="#D1DCF0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
