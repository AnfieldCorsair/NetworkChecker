<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetworkChecker.App.ViewModels"
             xmlns:core="using:NetworkChecker.Core.VpnAudit"
             x:Class="NetworkChecker.App.Views.WindowsStackSniView"
             x:DataType="vm:WindowsStackSniViewModel">

  <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="20">

    <!-- Левая колонка: Нативный аудит сетевого стека Windows -->
    <Border Grid.Column="0" Classes="card" Padding="14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="Сетевой стек Windows (Wintun / DNS / IPv6)" Classes="h2" />
              <TextBlock Text="{Binding OsSummary}" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить стек ОС" Classes="primary" Command="{Binding RefreshOsStackCommand}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <ScrollViewer>
          <StackPanel Spacing="14">
            <!-- Выводы аудита ОС -->
            <StackPanel Spacing="6">
              <TextBlock Text="Диагностика интерфейсов и утечек" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <ItemsControl ItemsSource="{Binding OsFindings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:VpnAuditFinding">
                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SimpleSummary}" FontSize="11.5" Foreground="#B8C5D9" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Remediation}" FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Активные адаптеры -->
            <StackPanel Spacing="6">
              <TextBlock Text="Активные сетевые адаптеры" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdapterDisplayItem">
                    <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Header}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DnsText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Локальные порты прокси -->
            <StackPanel Spacing="6">
              <TextBlock Text="Локальные прокси-порты (TCP Listeners)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <ItemsControl ItemsSource="{Binding LocalPorts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PortDisplayItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Text="{Binding PortLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                      <TextBlock Grid.Column="1" Text="{Binding StateText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Правая колонка: Многопоточный сканер соседей SNI в подсети /24 -->
    <Border Grid.Column="1" Classes="card" Padding="14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
          <TextBlock Text="Сканер «родного» Reality SNI в подсети /24" Classes="h2" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding TargetVpsHost, Mode=TwoWay}"
                     Watermark="IP или домен вашего VPS (например 185.100.87.10)" />
            <Button Grid.Column="1"
                    Content="Из аудита"
                    Command="{Binding FillFromActiveAuditCommand}" />
            <Button Grid.Column="2"
                    Content="Сканировать /24"
                    Classes="primary"
                    Command="{Binding ScanSubnetCommand}"
                    IsEnabled="{Binding !IsScanningSubnet}" />
          </Grid>
          <TextBlock Text="{Binding SubnetStatus}" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding SniNeighbors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SniNeighborDisplayItem">
                <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Domain}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Verdict}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CleanBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMuted}">
                        <Run Text="{Binding IpAddress}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Meta}" />
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Копировать SNI" Command="{Binding CopyCommand}" VerticalAlignment="Center" Padding="10,5" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
