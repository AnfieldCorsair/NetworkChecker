<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RKNHardering.App"
             x:Class="RKNHardering.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#0A0E13" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#0D1219" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#111823" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#16202D" />
          <SolidColorBrush x:Key="BorderBrush2" Color="#1E2A38" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E7EEF7" />
          <SolidColorBrush x:Key="TextMuted" Color="#8496A9" />
          <SolidColorBrush x:Key="AccentBrush" Color="#4EA1FF" />
          <SolidColorBrush x:Key="AccentSoft" Color="#15293F" />
          <SolidColorBrush x:Key="CleanBrush" Color="#35C48A" />
          <SolidColorBrush x:Key="WarnBrush" Color="#F5C542" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F0524C" />
          <SolidColorBrush x:Key="NoticeBrush" Color="#F2913D" />
          <SolidColorBrush x:Key="ChipBrush" Color="#1A2432" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#F4F6FA" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F3F8" />
          <SolidColorBrush x:Key="BorderBrush2" Color="#DCE3EC" />
          <SolidColorBrush x:Key="TextPrimary" Color="#101A24" />
          <SolidColorBrush x:Key="TextMuted" Color="#5A6B7C" />
          <SolidColorBrush x:Key="AccentBrush" Color="#1F6FEB" />
          <SolidColorBrush x:Key="AccentSoft" Color="#E3EEFE" />
          <SolidColorBrush x:Key="CleanBrush" Color="#15935F" />
          <SolidColorBrush x:Key="WarnBrush" Color="#B78600" />
          <SolidColorBrush x:Key="DangerBrush" Color="#D3373B" />
          <SolidColorBrush x:Key="NoticeBrush" Color="#C26A11" />
          <SolidColorBrush x:Key="ChipBrush" Color="#EDF1F7" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="MonoFont">DejaVu Sans Mono, Consolas, Menlo, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- ===== Типографика ===== -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.overline">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Карточки ===== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.card.tight">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,3" />
    </Style>

    <!-- ===== Кнопки ===== -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- ===== Навигация ===== -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>

    <Style Selector="Button.modetab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Button.modetab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    </Style>
    <Style Selector="Button.modetab.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.modetab.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>

    <!-- ===== Разное ===== -->
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
  </Application.Styles>
</Application>
